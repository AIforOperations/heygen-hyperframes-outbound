# =============================================================================
# Environment variable template. Copy this file to .env.local and fill in the
# real values. .env.local is gitignored — your real keys never leave your machine.
#
# Anything WITHOUT the NEXT_PUBLIC_ prefix is server-side only. Never put a
# secret in a NEXT_PUBLIC_* variable — those are bundled into the browser JS.
# =============================================================================

# ---- HeyGen ----
# Get from https://app.heygen.com → Settings → API. Shown once at creation.
HEYGEN_API_KEY=

# ---- Anthropic (for script generation) ----
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- ElevenLabs (post-render speech-to-text for word timestamps) ----
# Get from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ---- LinkedIn scraping (Apify) ----
# Get from https://console.apify.com → Settings → Integrations
APIFY_TOKEN=

# ---- (Optional) SerpAPI for company logo lookup ----
# Get from https://serpapi.com/manage-api-key
SERPAPI_KEY=

# ---- Public site URL (used in webhooks / share links) ----
# Locally: http://localhost:3030
# Vercel preview: leave blank, we use VERCEL_URL automatically
# Production: https://heygen-hyperframes-outbound.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# ---- Vercel platform tokens (do NOT set manually — pulled via `vercel env pull`) ----
# BLOB_READ_WRITE_TOKEN  → provisioned when a Blob store is connected to the project
# VERCEL_OIDC_TOKEN      → required by @vercel/sandbox for auth; auto on Vercel,
#                          pulled to .env.local with `vercel env pull` in dev
