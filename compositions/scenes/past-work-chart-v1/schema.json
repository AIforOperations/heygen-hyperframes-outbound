{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "past-work-chart-v1",
  "type": "object",
  "required": ["result_value", "claim_headline"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "maxLength": 32, "default": "Prior result" },
    "result_prefix": { "type": "string", "maxLength": 6 },
    "result_value": { "type": "number", "minimum": 0 },
    "result_suffix": { "type": "string", "maxLength": 12 },
    "result_decimals": { "type": "integer", "minimum": 0, "maximum": 2 },
    "claim_headline": { "type": "string", "minLength": 4, "maxLength": 140 },
    "claim_who": { "type": "string", "maxLength": 100 },
    "accent_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
  }
}
