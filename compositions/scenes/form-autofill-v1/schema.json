{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "form-autofill-v1",
  "type": "object",
  "required": ["form_title", "form_fields"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "maxLength": 40 },
    "form_title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "source_label": { "type": "string", "maxLength": 60 },
    "form_fields": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 28 },
          "value": { "type": "string", "minLength": 1, "maxLength": 28 }
        }
      }
    },
    "completion_label": { "type": "string", "maxLength": 28 },
    "completion_time": { "type": "string", "maxLength": 10 },
    "accent_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
  }
}
