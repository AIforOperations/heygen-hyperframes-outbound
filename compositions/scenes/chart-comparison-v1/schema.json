{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "chart-comparison-v1",
  "type": "object",
  "required": ["eyebrow", "metric_label", "rows"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 1, "maxLength": 60 },
    "metric_label": { "type": "string", "minLength": 1, "maxLength": 80 },
    "rows": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["label", "value_display", "value_percent"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "value_display": { "type": "string", "minLength": 1, "maxLength": 12 },
          "value_percent": { "type": "number", "minimum": 0, "maximum": 100 },
          "highlight": { "type": "boolean" }
        }
      }
    },
    "footnote": { "type": "string", "maxLength": 120 },
    "accent_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
  }
}
