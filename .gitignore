# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values stay local; commit only the template
.env*
!.env.example

# vercel
.vercel

# local test renders — keep JSON metadata, ignore binary MP4s
/video/*.mp4
/video/*.webm
/video/*.mov

# scratch / exploration — local-only, never committed
/work-*/
/design_audit/
/design_audit_*.png
/heygen_sales_integration.mp4
/openai_smart_device.mp4
/public/gallery/

# public/compositions/ is local compile output from
# scripts/compile-composition.mjs. Each folder is a compiled HTML +
# inlined avatar MP4 (3-15 MB). Final renders live in Vercel Blob,
# so we don't need these artifacts in the repo. Re-create locally
# by running compile-composition.mjs.
/public/compositions/

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# claude code per-project overrides (e.g. bg-isolation guard tweak)
.claude/
